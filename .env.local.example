# Copy this file to .env.local and fill in values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API

# Project URL (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" API key — safe to expose to the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SERVER ONLY, never expose. Used by check-in/streak APIs.
SUPABASE_SERVICE_ROLE_KEY=
